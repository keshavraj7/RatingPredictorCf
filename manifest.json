{
  "manifest_version": 3 ,
  "name": "Rating Predictor",
  "version": "1.0.0",
  "description": "Predict your rating",
  "icons" : {
    "128": "ic128.png",
    "48": "ic48.png",
    "16": "ic16.png"
  },
  "action":{
    "default_icon": "ic16.png",
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage",
    "scripting"
  ],

  "host_permissions": [
    "https://codeforces.com/*"
  ],

  "background": {
    "service_worker": "background/service-worker.js",
     "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["https://codeforces.com/contest/*"],
      "js": ["content/standings.js"],
      "css": ["styles/predictor.css"]
    }
  ]
}
